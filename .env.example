# Neon Postgres connection string (works with Vercel-integrated Neon)
# Example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Discord OAuth app credentials
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
